# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pinlearn
# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API. Required in production.
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
GITHUB_TOKEN=
YOUTUBE_API_KEY=
QUIZ_API_KEY=
